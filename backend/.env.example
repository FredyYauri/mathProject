# Copiar a .env y completar. Nunca commitear el archivo .env real.

NODE_ENV=development
PORT=3001

# Cadena de conexión de PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/matematicas_kids?schema=public"

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar tokens de sesión de padre/tutor (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Nombre de la cookie de sesión del padre/tutor
PARENT_SESSION_COOKIE_NAME=parent_session

# Sesión del niño en un dispositivo (la activa el padre/tutor desde /padres)
STUDENT_SESSION_COOKIE_NAME=student_session
STUDENT_SESSION_DAYS=180

# Base para `npm test` (se vacía en cada corrida: el nombre debe terminar en _test)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matematicas_kids_test?schema=public"
